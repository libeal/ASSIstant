{
  "schema_version": 1,
  "package_version": "1.0.0",
  "core_api": 1,
  "category": "system",
  "tools": [
    {
      "name": "config-backup",
      "description": "在变更或清理前为目标路径生成备份。",
      "entrypoint": "scripts/config-backup.sh",
      "risk": "medium",
      "approval_scope": "skill_readonly",
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
