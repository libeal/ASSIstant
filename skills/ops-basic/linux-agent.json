    },
    {
      "name": "disk-hotspots",
      "description": "采集磁盘热点目录、大文件与日志占用情况。",
      "entrypoint": "scripts/disk-hotspots.sh",
      "risk": "low",
      "approval_scope": "skill_readonly",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "采集路径",
            "description": "要统计的目录，默认 /var。",
            "default": "/var"
          },
          "top_n": {
            "type": "integer",
            "title": "返回条数",
            "description": "正整数，默认 10。",
            "default": 10
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": []
    },
    {
      "name": "log-cleanup-plan",
      "description": "扫描 `/var/log` 或 `/tmp` 下的大日志并生成清理建议。",
      "entrypoint": "scripts/log-cleanup-plan.sh",
      "risk": "low",
      "approval_scope": "skill_readonly",
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": []
    },
    {
      "name": "log-search",
      "description": "检索 `/var/log` 下的日志文件；默认不读取 journal，可通过参数显式启用。",
      "entrypoint": "scripts/log-search.sh",
      "risk": "low",
      "approval_scope": "skill_readonly",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "日志路径",
            "description": "必须位于 /var/log，默认 /var/log。",
            "default": "/var/log"
          },
          "keyword": {
            "type": "string",
            "title": "关键词",
            "description": "检索关键词，默认 error。",
            "default": "error"
          },
          "lines": {
            "type": "integer",
            "title": "返回行数",
            "description": "正整数，默认 20。",
            "default": 20
          },
          "include_journal": {
            "type": "boolean",
            "title": "包含 journal",
            "description": "默认 false，不读取 journal。",
            "default": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": []
    },
    {
      "name": "process-inspect",
      "description": "检查进程、僵尸进程与匹配模式进程状态。",
      "entrypoint": "scripts/process-inspect.sh",
      "risk": "low",
      "approval_scope": "skill_readonly",
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": []
    },
    {
      "name": "resource-inspect",
      "description": "查看 CPU 负载、内存概况和高 CPU/内存进程。",
      "entrypoint": "scripts/resource-inspect.sh",
      "risk": "low",
      "approval_scope": "skill_readonly",
      "input_schema": {
        "type": "object",
        "properties": {
          "top_n": {
            "type": "integer",
            "title": "返回条数",
            "description": "正整数，默认 10。",
            "default": 10
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": []
    },
    {
      "name": "safe-log-cleanup",
      "description": "对允许范围内的非关键日志执行安全截断。",
      "entrypoint": "scripts/safe-log-cleanup.sh",
      "risk": "high",
      "approval_scope": "skill_readonly",
      "execution": {
        "class": "runner",
        "capability": "",
        "dispatch": "always"
      },
      "runtime_inputs": [],
      "guards": [
        {
          "type": "backup_proof",
          "mode": "required_on_apply",
          "condition": {
            "field": "dry_run",
            "equals": false,
            "default": true
          },
          "proofs": [
            {
              "argument": "backup_archive",
              "validation": "nonempty_string"
            },
            {
              "argument": "backup_sha256",
              "validation": "sha256"
            }
          ],
          "source": {
            "tool": "system.config.backup",
            "target_argument": "path",
            "target_output": "path",
            "target_normalization": "realpath_existing",
            "values": [
              {
                "argument": "backup_archive",
                "output": "archive",
                "validation": "nonempty_string"
              },
              {
                "argument": "backup_sha256",
                "output": "source_sha256",
                "validation": "sha256"
              }
            ]
          },
          "message": "真实变更必须先完成目标备份，并携带未改变目标的备份凭据。"
        }
      ]
    },
    {
      "name": "service-inspect",
      "description": "查看 systemd 服务状态与失败服务。",
      "entrypoint": "scripts/service-inspect.sh",
