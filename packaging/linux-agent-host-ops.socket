[Unit]
Description=Linux Agent narrow host operations socket
PartOf=linux-agent-web.service

[Socket]
ListenStream=/run/linux-agent/host-ops.sock
Service=linux-agent-host-ops.service
SocketUser=root
SocketGroup=linux-agent
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
