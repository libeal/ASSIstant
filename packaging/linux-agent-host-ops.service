[Unit]
Description=Linux Agent narrow allowlisted host operations helper
Requires=linux-agent-host-ops.socket
After=linux-agent-host-ops.socket
PartOf=linux-agent-web.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/linux-agent/current/lib/host_ops_helper.py serve
Environment=LINUX_AGENT_SERVICE_USER=linux-agent
Environment=LINUX_AGENT_ROOT=/opt/linux-agent/current
Environment=LINUX_AGENT_BUILTIN_SKILLS_DIR=/opt/linux-agent/skills
Environment=LINUX_AGENT_RELEASE_MANIFEST=/opt/linux-agent/release-manifest.json
Environment=LINUX_AGENT_DATA_DIR=/opt/linux-agent/data
Environment=LINUX_AGENT_HOST_OPS_POLICY_PATH=/etc/linux-agent/host-ops-policy.json
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
# CAP_CHOWN preserves existing file ownership on same-directory temporary files;
# no arbitrary command, unit, or path capability is exposed.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
ProtectSystem=strict
ReadWritePaths=/etc
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
PrivateDevices=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
StandardOutput=journal
StandardError=journal
