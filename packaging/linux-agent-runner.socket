[Unit]
Description=Linux Agent unprivileged execution runner socket
PartOf=linux-agent-web.service

[Socket]
ListenStream=/run/linux-agent/runner.sock
Service=linux-agent-runner.service
SocketUser=linux-agent
# The runner service receives the activated descriptor from systemd and does
# not need to connect back to its own socket. SocketMode=0600 keeps the
# explicitly assigned group from granting a Runner process protocol access.
SocketGroup=linux-agent
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
