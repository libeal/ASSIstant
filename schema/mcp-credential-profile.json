{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://linux-agent.local/schema/mcp-credential-profile.json",
    "title": "Linux Agent MCP credential profile",
    "type": "object",
    "required": ["profile_version", "id", "type", "server_id", "server_url"],
    "additionalProperties": false,
    "properties": {
        "profile_version": {
            "type": "integer",
            "const": 1
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "maxLength": 128
        },
        "type": {
            "type": "string",
            "enum": ["static_headers", "oauth_authorization_code", "oauth_client_credentials"]
        },
        "server_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "maxLength": 128
        },
        "server_url": {
            "type": "string",
            "format": "mcp-http-url",
            "maxLength": 8192
        },
        "authorization_server_issuer": {
            "type": "string",
            "format": "mcp-oauth-issuer-url",
            "maxLength": 8192
        },
        "token_issuer": {
            "type": "string",
            "format": "mcp-oauth-issuer-url",
            "maxLength": 8192
        },
        "headers": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
                "type": "string",
                "format": "mcp-credential-header-name"
            },
            "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536,
                "pattern": "^[^\\r\\n]*$"
            }
        },
        "client_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["redirect_uris", "application_type"],
            "properties": {
                "redirect_uris": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "type": "string",
                        "format": "mcp-oauth-redirect-url",
                        "maxLength": 8192
                    }
                },
                "application_type": {
                    "type": "string",
                    "enum": ["native", "web"]
                },
                "grant_types": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {"type": "string", "maxLength": 256}
                },
                "response_types": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {"type": "string", "maxLength": 256}
                },
                "token_endpoint_auth_method": {
                    "type": ["string", "null"],
                    "maxLength": 128
                },
                "scope": {
                    "type": "string",
                    "maxLength": 4096
                },
                "client_name": {
                    "type": "string",
                    "maxLength": 256
                }
            }
        },
        "client_metadata_url": {
            "type": "string",
            "format": "mcp-https-document-url",
            "maxLength": 8192
        },
        "allow_dynamic_registration": {
            "type": "boolean",
            "default": false
        },
        "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["access_token"],
            "properties": {
                "access_token": {"type": "string", "minLength": 1, "maxLength": 65536},
                "token_type": {"type": "string", "enum": ["Bearer", "bearer"]},
                "expires_in": {"type": "integer", "minimum": 0},
                "scope": {"type": "string", "maxLength": 4096},
                "refresh_token": {"type": "string", "minLength": 1, "maxLength": 65536}
            }
        },
        "client_info": {
            "type": "object",
            "maxProperties": 32
        },
        "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
        },
        "application_type": {
            "type": "string",
            "enum": ["native", "web"]
        },
        "client_secret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
        },
        "token_endpoint_auth_method": {
            "type": "string",
            "enum": ["client_secret_basic", "client_secret_post"]
        },
        "scope": {
            "type": "string",
            "maxLength": 4096
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {"type": {"const": "static_headers"}},
                "required": ["type"]
            },
            "then": {"required": ["headers"]}
        },
        {
            "if": {
                "properties": {"type": {"const": "oauth_authorization_code"}},
                "required": ["type"]
            },
            "then": {"required": ["authorization_server_issuer", "client_metadata"]}
        },
        {
            "if": {
                "properties": {"type": {"const": "oauth_client_credentials"}},
                "required": ["type"]
            },
            "then": {
                "required": [
                    "authorization_server_issuer",
                    "client_id",
                    "client_secret",
                    "token_endpoint_auth_method",
                    "application_type"
                ]
            }
        },
        {
            "if": {"required": ["tokens"]},
            "then": {"required": ["token_issuer"]}
        },
        {
            "if": {"required": ["token_issuer"]},
            "then": {"required": ["tokens"]}
        }
    ]
}
